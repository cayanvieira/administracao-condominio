    "@langchain/openai": "^1.5.10",
    "@openrouter/sdk": "^1.2.69",
    "@types/node": "^24.10.12",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "langchain": "^1.5.10",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
